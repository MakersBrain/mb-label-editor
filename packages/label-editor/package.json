{
  "name": "@makersbrain/label-editor",
  "version": "0.1.0",
  "description": "Reusable Svelte 5 thermal label editor",
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./core.css": "./dist/core.css",
    "./themes/standalone.css": "./dist/themes/standalone.css",
    "./themes/mb-ui.css": "./dist/themes/mb-ui.css"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "generate:asset-catalog": "node scripts/generate-asset-catalog-client.mjs",
    "generate:cloud-print": "node scripts/generate-cloud-print-client.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.4",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
